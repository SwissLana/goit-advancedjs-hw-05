{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "ESNext",
    "target": "ES2020",
    "lib": ["dom", "esnext"],

    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}

